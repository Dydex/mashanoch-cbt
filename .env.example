# Copy to .env and fill in. Values come from the Supabase dashboard,
# Project Settings → API (keys) and Project Settings → Database (password).

# Derived from the project ref. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public key. Safe to expose to the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ADMIN LEVEL — bypasses row level security entirely.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where Supabase sends people back after an invitation or password-reset email.
# Must also be listed under Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres password, used for applying migrations. Not used by the app.
SUPABASE_PASSWORD=
